# Single public entry point for the demo deployment.
#
# Only this container binds a host port that the AWS security group opens.
# Every backend is reached over the Compose network by service name, so the
# other published host ports stay unreachable from the internet.
#
# TLS is off because a bare EC2 public DNS name cannot obtain a Let's Encrypt
# certificate. See docs/aws_demo_deployment.md for the domain-backed HTTPS
# variant. Treat this as a time-boxed demo posture, not an internet-grade one.
#
# auth.conf holds the basic_auth block and is generated by
# scripts/deploy/make-secrets.sh. It is imported rather than injected through
# the environment because a bcrypt hash is full of '$' characters, which
# Compose would try to interpolate.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	log {
		output stdout
		format console
	}

	# Feedback API. Authentication is the service's own X-API-Key.
	# handle_path strips /api so uvicorn --root-path /api renders /api/docs correctly.
	handle_path /api/* {
		reverse_proxy feedback-api:8000
	}

	# Grafana serves correctly from a sub path given GF_SERVER_SERVE_FROM_SUB_PATH.
	# The prefix is preserved, so plain handle rather than handle_path.
	# Grafana enforces its own login.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Prometheus, MLflow, and the Flink REST API ship no authentication of their
	# own, so the proxy supplies it.
	# Prometheus runs with route-prefix / so its self-scrape and healthcheck keep
	# working, so the prefix is stripped here rather than inside Prometheus.
	redir /prometheus /prometheus/
	handle_path /prometheus/* {
		import /etc/caddy/auth.conf
		reverse_proxy prometheus:9090
	}

	handle /mlflow* {
		import /etc/caddy/auth.conf
		reverse_proxy mlflow:5000
	}

	# Flink REST endpoints only (/flink/overview, /flink/jobs/overview).
	# The bundled web UI assumes it is mounted at the root and renders broken
	# under a stripped prefix, so the full console is reached by SSH tunnel.
	handle_path /flink/* {
		import /etc/caddy/auth.conf
		reverse_proxy jobmanager:8081
	}

	handle {
		root * /srv
		file_server
	}
}
